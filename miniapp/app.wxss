/* ========== Global Styles ========== */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background-color: #f5f5f5;
  color: #333;
  font-size: 14px;
  box-sizing: border-box;
}

/* ========== Card Styles ========== */
.card {
  background: #ffffff;
  border-radius: 12px;
  padding: 16px;
  margin: 10px 16px;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
}

.card-no-margin {
  background: #ffffff;
  border-radius: 12px;
  padding: 16px;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
}

/* ========== Button Styles ========== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 44px;
  border-radius: 22px;
  font-size: 16px;
  font-weight: 500;
  border: none;
  outline: none;
  cursor: pointer;
  transition: opacity 0.2s;
  padding: 0 24px;
  width: 100%;
}

.btn:active {
  opacity: 0.8;
}

.btn-primary {
  background-color: #07c160;
  color: #ffffff;
}

.btn-danger {
  background-color: #e64340;
  color: #ffffff;
}

.btn-outline {
  background-color: transparent;
  color: #07c160;
  border: 1px solid #07c160;
}

.btn-outline-danger {
  background-color: transparent;
  color: #e64340;
  border: 1px solid #e64340;
}

.btn-small {
  height: 32px;
  font-size: 13px;
  border-radius: 16px;
  padding: 0 14px;
  width: auto;
  display: inline-flex;
}

.btn-disabled {
  background-color: #c8c8c8;
  color: #ffffff;
}

.btn-block {
  width: 100%;
}

/* ========== Badge Styles ========== */
.badge {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 10px;
  font-size: 11px;
  font-weight: 500;
  line-height: 1.6;
}

.badge-green {
  background-color: #e8f8e8;
  color: #07c160;
}

.badge-yellow {
  background-color: #fff7e6;
  color: #f5a623;
}

.badge-red {
  background-color: #ffe8e8;
  color: #e64340;
}

.badge-gray {
  background-color: #f0f0f0;
  color: #999;
}

.badge-blue {
  background-color: #e8f0fe;
  color: #1a73e8;
}

/* ========== Calendar Grid ========== */
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
  width: 100%;
}

.calendar-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 0;
}

.calendar-header .month-text {
  font-size: 16px;
  font-weight: 600;
  color: #333;
}

.calendar-nav-btn {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 18px;
  color: #666;
  border-radius: 50%;
}

.calendar-nav-btn:active {
  background-color: #f0f0f0;
}

.day-header {
  width: 14.28%;
  text-align: center;
  font-size: 12px;
  color: #999;
  padding: 8px 0;
  font-weight: 500;
}

.day-cell {
  width: 14.28%;
  text-align: center;
  padding: 8px 0;
  font-size: 14px;
  color: #333;
  position: relative;
  min-height: 40px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.day-cell:active {
  background-color: #f0f0f0;
}

.day-cell.selected {
  background-color: #07c160;
  color: #ffffff;
  border-radius: 50%;
  width: 36px;
  height: 36px;
  margin: 0 auto;
}

.day-cell.today {
  font-weight: 700;
  color: #07c160;
}

.day-cell.selected.today {
  color: #ffffff;
}

.day-cell.other-month {
  color: #ccc;
}

.day-cell .dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background-color: #07c160;
  margin-top: 2px;
}

.day-cell.selected .dot {
  background-color: #ffffff;
}

/* ========== Time Slots ========== */
.time-slots {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 8px 0;
}

.time-slot-item {
  padding: 8px 16px;
  border-radius: 8px;
  font-size: 13px;
  border: 1px solid #e0e0e0;
  color: #333;
  background: #fff;
  text-align: center;
  min-width: 80px;
}

.time-slot-item:active {
  opacity: 0.7;
}

.time-slot-item.selected {
  background-color: #07c160;
  color: #ffffff;
  border-color: #07c160;
}

.time-slot-item.disabled {
  background-color: #f5f5f5;
  color: #ccc;
  border-color: #eee;
}

.time-slot-item.booked {
  background-color: #fff7e6;
  color: #f5a623;
  border-color: #f5a623;
}

.time-slot-item .slot-label {
  display: block;
  font-size: 13px;
}

.time-slot-item .slot-sub {
  display: block;
  font-size: 10px;
  margin-top: 2px;
  opacity: 0.7;
}

/* ========== Schedule Row ========== */
.schedule-row {
  display: flex;
  align-items: center;
  padding: 10px 0;
  border-bottom: 1px solid #f0f0f0;
}

.schedule-row:last-child {
  border-bottom: none;
}

.schedule-row .day-label {
  width: 80px;
  font-size: 14px;
  color: #333;
  font-weight: 500;
}

.schedule-row .slot-list {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

/* ========== Time Picker Button ========== */
.time-pick-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 16px;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  font-size: 15px;
  color: #333;
  background: #fff;
  min-width: 80px;
  text-align: center;
}

/* ========== Note Text ========== */
.note-text {
  font-size: 12px;
  color: #999;
  padding: 4px 0 8px;
}

/* ========== Empty State ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 20px;
  color: #999;
}

.empty-state .empty-icon {
  font-size: 48px;
  margin-bottom: 12px;
}

.empty-state .empty-text {
  font-size: 14px;
  color: #999;
}

/* ========== Loading ========== */
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40px 0;
}

.loading .loading-text {
  font-size: 13px;
  color: #999;
  margin-left: 8px;
}

/* ========== Modal ========== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background: #fff;
  border-radius: 12px;
  padding: 24px;
  width: 80%;
  max-width: 320px;
}

.modal-content .modal-title {
  font-size: 17px;
  font-weight: 600;
  text-align: center;
  margin-bottom: 8px;
}

.modal-content .modal-body {
  font-size: 14px;
  color: #666;
  text-align: center;
  margin-bottom: 20px;
  line-height: 1.6;
}

.modal-actions {
  display: flex;
  gap: 10px;
}

.modal-actions .btn {
  flex: 1;
}

/* ========== Input Group ========== */
.input-group {
  margin-bottom: 16px;
}

.input-group .input-label {
  display: block;
  font-size: 13px;
  color: #666;
  margin-bottom: 6px;
  font-weight: 500;
}

.input-group .input-field {
  width: 100%;
  height: 44px;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 15px;
  color: #333;
  background: #fff;
  box-sizing: border-box;
}

.input-group .input-field:focus {
  border-color: #07c160;
}

.input-group textarea.input-field {
  height: auto;
  min-height: 80px;
  padding: 12px;
  line-height: 1.5;
}

/* ========== Toast ========== */
.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.75);
  color: #fff;
  padding: 12px 24px;
  border-radius: 8px;
  font-size: 14px;
  z-index: 9999;
  animation: toastFadeIn 0.3s ease;
  max-width: 80%;
  text-align: center;
}

@keyframes toastFadeIn {
  from {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.9);
  }
  to {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
}

/* ========== Form ========== */
.form-group {
  margin-bottom: 20px;
}

.form-label {
  display: block;
  font-size: 14px;
  color: #333;
  margin-bottom: 8px;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 44px;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  padding: 0 12px;
  font-size: 15px;
  color: #333;
  background: #fff;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #07c160;
}

.form-textarea {
  width: 100%;
  min-height: 80px;
  border: 1px solid #e0e0e0;
  border-radius: 8px;
  padding: 12px;
  font-size: 15px;
  color: #333;
  background: #fff;
  box-sizing: border-box;
  line-height: 1.5;
}

/* ========== Tab Bar ========== */
.tab-bar {
  display: flex;
  background: #fff;
  border-top: 1px solid #e0e0e0;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 6px 0 4px;
  color: #999;
  font-size: 10px;
}

.tab-item.active {
  color: #07c160;
}

.tab-item .tab-icon {
  width: 24px;
  height: 24px;
  margin-bottom: 2px;
}

/* ========== Section Title ========== */
.section-title {
  font-size: 16px;
  font-weight: 600;
  color: #333;
  padding: 12px 16px 8px;
}

.section-subtitle {
  font-size: 12px;
  color: #999;
  padding: 0 16px 8px;
}

/* ========== Divider ========== */
.divider {
  height: 1px;
  background-color: #f0f0f0;
  margin: 12px 0;
}

/* ========== Flex Helpers ========== */
.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-1 {
  flex: 1;
}

/* ========== Spacing ========== */
.mt-4 { margin-top: 4px; }
.mt-8 { margin-top: 8px; }
.mt-12 { margin-top: 12px; }
.mt-16 { margin-top: 16px; }
.mb-8 { margin-bottom: 8px; }
.mb-12 { margin-bottom: 12px; }
.mb-16 { margin-bottom: 16px; }
.p-16 { padding: 16px; }
.pb-safe { padding-bottom: env(safe-area-inset-bottom, 0); }

/* ========== Text ========== */
.text-center { text-align: center; }
.text-right { text-align: right; }
.text-primary { color: #07c160; }
.text-danger { color: #e64340; }
.text-warning { color: #f5a623; }
.text-muted { color: #999; }
.text-sm { font-size: 12px; }
.text-xs { font-size: 11px; }
.text-lg { font-size: 16px; }
.text-bold { font-weight: 600; }
.text-through { text-decoration: line-through; }

/* ========== Scroll Area ========== */
.scroll-area {
  height: 100vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

/* ========== Notification Delete ========== */
.del-notif {
  padding: 4px 8px;
  font-size: 14px;
}

/* ========== Slot Check Mark ========== */
.slot-check {
  display: block;
  font-size: 10px;
  margin-top: 2px;
  color: #fff;
}
