.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding: 60px 32px 40px;
  background: linear-gradient(180deg, #f0fff4 0%, #f5f5f5 100%);
  box-sizing: border-box;
}

.login-logo {
  font-size: 64px;
  margin-bottom: 12px;
}

.login-title {
  font-size: 22px;
  font-weight: 700;
  color: #333;
  margin-bottom: 6px;
  text-align: center;
}

.login-subtitle {
  font-size: 14px;
  color: #999;
  margin-bottom: 36px;
  text-align: center;
}

.login-form {
  width: 100%;
  max-width: 340px;
}

.login-form .input-group {
  margin-bottom: 16px;
}

.login-form .input-label {
  display: block;
  font-size: 14px;
  color: #333;
  margin-bottom: 6px;
  font-weight: 500;
}

.login-form .input-field {
  width: 100%;
  height: 48px;
  border: 1px solid #e0e0e0;
  border-radius: 12px;
  padding: 0 14px;
  font-size: 16px;
  color: #333;
  background: #fff;
  box-sizing: border-box;
}

.login-form .input-field:focus {
  border-color: #07c160;
}

.login-form .btn {
  margin-top: 24px;
  height: 48px;
  border-radius: 24px;
  font-size: 17px;
  font-weight: 600;
}

.login-toggle {
  margin-top: 20px;
  font-size: 14px;
  color: #07c160;
  padding: 8px;
}

.login-toggle:active {
  opacity: 0.7;
}

.login-note {
  margin-top: 40px;
  font-size: 12px;
  color: #999;
  text-align: center;
  line-height: 1.6;
}
