.page {
  padding: 16px;
  background: #f5f5f5;
  min-height: 100vh;
}

.avatar {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: #07c160;
  color: white;
  font-size: 28px;
  line-height: 64px;
  text-align: center;
  margin: 0 auto 12px;
}

.user-name {
  display: block;
  font-size: 20px;
  font-weight: 600;
  color: #333;
  margin-bottom: 4px;
}

.user-phone {
  display: block;
  font-size: 14px;
  color: #999;
  margin-bottom: 8px;
}

.user-role-tag {
  display: inline-block;
  padding: 2px 12px;
  border-radius: 10px;
  background: #07c160;
  color: white;
  font-size: 12px;
}

.user-role-tag.student-tag {
  background: #1aad19;
}

.stats-row {
  display: flex;
  justify-content: space-around;
  padding: 12px 0;
}

.stat-item {
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 24px;
  font-weight: 600;
  color: #07c160;
}

.stat-label {
  display: block;
  font-size: 12px;
  color: #999;
  margin-top: 4px;
}

.menu-group {
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 16px 16px;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 20px;
  margin-right: 12px;
}

.menu-text {
  flex: 1;
  font-size: 15px;
  color: #333;
}

.menu-arrow {
  color: #ccc;
  font-size: 20px;
}

.text-danger {
  color: #e64340 !important;
}

.btn-block {
  width: 100%;
}
