<view class="page">
  <view class="section-title">预约管理</view>

  <view wx:if="{{loading}}" class="loading">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 时段锁定 -->
  <view class="card" style="padding:16px;">
    <view class="section-title" style="padding:0 0 8px;">锁定管理</view>
    <view class="input-group">
      <text class="input-label">选择日期查看时段</text>
      <input class="input-field" type="text" placeholder="YYYY-MM-DD" value="{{lockDate}}" bindinput="onLockDate" />
    </view>
    <button class="btn btn-sm btn-outline" bindtap="loadLockSlots">查看时段</button>

    <view wx:if="{{lockSlots.length > 0}}" class="mt-8">
      <view wx:for="{{lockSlots}}" wx:key="start_time" style="display:flex;align-items:center;padding:6px 0;border-bottom:1px solid #f0f0f0;font-size:13px;">
        <text style="flex:1;">{{item.start_time}}</text>
        <text wx:if="{{item.slot_status === 'booked'}}" style="color:#f5a623;margin-right:8px;">已预约</text>
        <text wx:elif="{{item.slot_status === 'locked'}}" style="color:#e64340;margin-right:8px;">已锁定</text>
        <text wx:else style="color:#07c160;margin-right:8px;">可用</text>
        <button class="btn btn-small btn-outline-danger" wx:if="{{item.slot_status === 'locked'}}" bindtap="unlockSlot" data-time="{{item.start_time}}" style="margin:0;">解锁</button>
        <button class="btn btn-small btn-outline" wx:if="{{item.slot_status === 'available'}}" bindtap="lockSlot" data-time="{{item.start_time}}" style="margin:0;">锁定</button>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && bookings.length === 0}}" class="empty-state">
    <text class="empty-icon">*</text>
    <text class="empty-text">暂无预约记录</text>
  </view>

  <view wx:else>
    <view class="admin-booking-card card" wx:for="{{bookings}}" wx:key="id" wx:for-item="b">
      <view class="flex-between">
        <view>
          <text class="admin-booking-name">{{b.user_name || b.name}}</text>
          <text class="admin-booking-phone" data-phone="{{b.user_phone || b.phone}}" bindtap="callStudent">📞 {{b.user_phone || b.phone}}</text>
        </view>
        <text class="badge 
          {{b.status == 'confirmed' ? 'badge-green' : ''}}
          {{b.status == 'completed' ? 'badge-gray' : ''}}
          {{b.status == 'cancelled' ? 'badge-red' : ''}}
        ">
          {{b.status == 'confirmed' ? '已预约' : ''}}
          {{b.status == 'completed' ? '已完成' : ''}}
          {{b.status == 'cancelled' ? '已取消' : ''}}
        </text>
      </view>
      <view class="admin-booking-detail">
        <text>📅 {{util.fmtDisplay(b.date)}} {{b.start_time}}</text>
        <text wx:if="{{b.note}}">📝 {{b.note}}</text>
      </view>
      <view class="admin-booking-actions">
        <button class="btn btn-small btn-outline" wx:if="{{b.status == 'confirmed'}}" bindtap="completeBooking" data-id="{{b.id}}">完成课程</button>
        <button class="btn btn-small btn-outline-danger" wx:if="{{b.status != 'completed' && b.status != 'cancelled'}}" bindtap="adminCancel" data-id="{{b.id}}">取消</button>
      </view>
    </view>
  </view>
</view>
