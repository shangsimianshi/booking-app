.page {
  padding-bottom: 20px;
}

.schedule-row {
  display: flex;
  align-items: flex-start;
  padding: 10px 0;
  border-bottom: 1px solid #f0f0f0;
}

.schedule-row:last-child {
  border-bottom: none;
}

.day-label {
  width: 50px;
  font-size: 14px;
  color: #333;
  font-weight: 500;
  padding-top: 6px;
  flex-shrink: 0;
}

.slot-list {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.ml-8 {
  margin-left: 8px;
}
