.page {
  padding-bottom: 20px;
}

.streak-card {
  text-align: center;
  padding: 30px 16px;
}

.streak-value {
  font-size: 48px;
  font-weight: 700;
  color: #07c160;
  line-height: 1.2;
}

.streak-label {
  font-size: 14px;
  color: #999;
  margin-top: 4px;
  display: block;
}

.checkin-item {
  padding: 12px 0;
  border-bottom: 1px solid #f0f0f0;
}

.checkin-item:last-child {
  border-bottom: none;
}

.checkin-name {
  font-size: 14px;
  color: #333;
  font-weight: 500;
}

.checkin-time {
  font-size: 12px;
}
