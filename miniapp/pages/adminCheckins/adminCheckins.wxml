<view class="page">
  <view class="section-title">今日打卡统计</view>
  <view class="card">
    <view class="stats-grid" style="grid-template-columns:1fr 1fr 1fr;">
      <view class="stat-item" style="text-align:center;">
        <text class="stat-value">{{todayStats.total || 0}}</text>
        <text class="stat-label">今日打卡</text>
      </view>
      <view class="stat-item" style="text-align:center;">
        <text class="stat-value">{{todayStats.students || 0}}</text>
        <text class="stat-label">打卡人数</text>
      </view>
      <view class="stat-item" style="text-align:center;">
        <text class="stat-value">{{todayStats.rate || '0%'}}</text>
        <text class="stat-label">打卡率</text>
      </view>
    </view>
  </view>

  <view class="section-title">打卡排行（按连续天数）</view>
  <view wx:if="{{students.length === 0}}" class="empty-state">
    <text class="empty-text">暂无打卡数据</text>
  </view>
  <view wx:else class="card">
    <view class="rank-item flex-between" wx:for="{{students}}" wx:key="id" wx:for-item="s">
      <view class="flex-row" style="gap:8px;">
        <text class="rank-num {{s.rank <= 3 ? 'rank-top' : ''}}">{{s.rank}}</text>
        <text class="rank-name">{{s.name}}</text>
      </view>
      <view class="flex-row" style="gap:6px;">
        <text class="badge badge-green">🔥 {{s.streak}}天</text>
        <text class="text-sm text-muted">共{{s.total}}次</text>
      </view>
    </view>
  </view>
</view>
