.page {
  padding-bottom: 20px;
}

.rank-item {
  padding: 12px 0;
  border-bottom: 1px solid #f0f0f0;
}

.rank-item:last-child {
  border-bottom: none;
}

.rank-num {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  text-align: center;
  line-height: 24px;
  font-size: 12px;
  font-weight: 600;
  color: #999;
  background: #f0f0f0;
}

.rank-num.rank-top {
  color: #fff;
  background: #f5a623;
}

.rank-name {
  font-size: 14px;
  color: #333;
  font-weight: 500;
}
